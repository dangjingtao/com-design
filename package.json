{
  "name": "@com-design/build",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Com Design multi-target build pipeline",
  "scripts": {
    "validate": "node tooling/bin/validate.mjs",
    "test": "node --test tooling/test/*.test.mjs",
    "build:engineering": "node tooling/bin/build.mjs",
    "build:penpot": "node penpot/bin/build.mjs",
    "build:all": "node tooling/bin/build-all.mjs",
    "ci:evidence": "node tooling/bin/ci-evidence.mjs",
    "build": "npm run build:all",
    "smoke:four-platform": "node tooling/bin/smoke-four-platform.mjs",
    "governance:dry-run": "node tooling/bin/release-governance.mjs",
    "governance:evaluate": "node tooling/bin/release-governance.mjs",
    "build:component-css": "node tooling/bin/extract-components-css.mjs",
    "check:component-css": "node tooling/bin/extract-components-css.mjs --check",
    "build:human": "node tooling/bin/human-guide-v2.mjs",
    "check:human-guide": "node tooling/bin/human-guide-token-compliance.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
