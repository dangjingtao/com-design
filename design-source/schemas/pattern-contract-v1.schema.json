{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://com-design.local/schemas/pattern-contract-v1.schema.json",
  "title": "Com Design Core Pattern Collection",
  "type": "object",
  "required": ["schemaVersion", "scope", "status", "principle", "patterns"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "principle": { "type": "string", "minLength": 1 },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "cn", "intent", "components", "anatomy", "rules", "avoid"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "name": { "type": "string", "minLength": 1 },
          "cn": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "components": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "anatomy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "avoid": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
