{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://com-design.local/schemas/mobile-search-filter-v2.schema.json",
  "title": "Com Design Mobile Search + Filter Workflow V2",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "$metadata",
    "scope",
    "references",
    "collectionQueryModel",
    "search",
    "filter",
    "restoration",
    "platformMappings",
    "examples"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 2 },
    "id": { "const": "com-design:mobile-search-filter:v2" },
    "$metadata": {
      "type": "object",
      "required": ["name", "owner", "status", "canonical"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "const": "T021" },
        "status": { "type": "string", "minLength": 1 },
        "canonical": { "const": true }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["platforms", "addsCoreComponent", "addsCorePattern"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["ios", "android", "wechat-mini-program"] }
        },
        "addsCoreComponent": { "const": false },
        "addsCorePattern": { "const": false }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "required": ["components", "composites", "patterns", "platformEnvironment", "layoutInputFoundation"],
      "properties": {
        "components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "composites": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "patterns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "platformEnvironment": { "const": "com-design:platform-environment:v1" },
        "layoutInputFoundation": { "const": "com-design:layout-input-foundation:v2" }
      },
      "additionalProperties": false
    },
    "collectionQueryModel": {
      "type": "object",
      "required": [
        "authoritativeOwner",
        "fields",
        "independence",
        "continuationInvalidation",
        "filterDraft"
      ],
      "properties": {
        "authoritativeOwner": { "const": "collection-owner" },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pendingQuery",
              "committedQuery",
              "committedFilters",
              "sort",
              "continuation",
              "restorationState"
            ]
          }
        },
        "independence": {
          "type": "object",
          "required": ["clearQueryPreservesFilters", "resetFiltersPreservesQuery", "sortIndependent"],
          "properties": {
            "clearQueryPreservesFilters": { "const": true },
            "resetFiltersPreservesQuery": { "const": true },
            "sortIndependent": { "const": true }
          },
          "additionalProperties": false
        },
        "continuationInvalidation": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["committedQuery", "committedFilters", "sort"] }
        },
        "filterDraft": {
          "type": "object",
          "required": [
            "separateFromCommitted",
            "initializeFromCommittedOnOpen",
            "dismissWithoutApply",
            "apply",
            "reset",
            "reopenSource",
            "externalQueryChangePolicy"
          ],
          "properties": {
            "separateFromCommitted": { "const": true },
            "initializeFromCommittedOnOpen": { "const": true },
            "dismissWithoutApply": { "const": "discard-draft" },
            "apply": { "const": "commit-draft-refresh-close" },
            "reset": { "const": "reset-draft-only" },
            "reopenSource": { "const": "current-committed-filters" },
            "externalQueryChangePolicy": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["cancel-draft", "rebase-draft"] }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "required": ["lifecycleStates", "ime", "submissionModes", "semantics", "asyncPolicy"],
      "properties": {
        "lifecycleStates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "idle",
              "focused-empty",
              "typing",
              "composing",
              "suggesting",
              "searching",
              "results",
              "zero-results",
              "recoverable-error"
            ]
          }
        },
        "ime": {
          "type": "object",
          "required": [
            "compositionIsPendingInput",
            "commitWhileComposing",
            "debounceStartsAfterCompositionEnd",
            "platformEventNamesCanonical"
          ],
          "properties": {
            "compositionIsPendingInput": { "const": true },
            "commitWhileComposing": { "const": false },
            "debounceStartsAfterCompositionEnd": { "const": true },
            "platformEventNamesCanonical": { "const": false }
          },
          "additionalProperties": false
        },
        "submissionModes": {
          "type": "object",
          "required": ["instant-debounced", "explicit-submit"],
          "properties": {
            "instant-debounced": {
              "type": "object",
              "required": ["debounceAfterCompositionEnd", "requestCancellation", "staleResponseGuard"],
              "properties": {
                "debounceAfterCompositionEnd": { "const": true },
                "requestCancellation": { "const": true },
                "staleResponseGuard": { "const": true }
              },
              "additionalProperties": false
            },
            "explicit-submit": {
              "type": "object",
              "required": ["commitWhileComposing", "commitTriggers"],
              "properties": {
                "commitWhileComposing": { "const": false },
                "commitTriggers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["keyboard-search", "enter-confirm", "explicit-action"] }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "semantics": {
          "type": "object",
          "required": ["clearQuery", "cancelBack", "zeroResultsDistinctFromError"],
          "properties": {
            "clearQuery": { "const": "clear-query-keep-search-context" },
            "cancelBack": { "const": "exit-or-return-search-context" },
            "zeroResultsDistinctFromError": { "const": true }
          },
          "additionalProperties": false
        },
        "asyncPolicy": {
          "type": "object",
          "required": ["suggestionStaleResponseGuard", "resultStaleResponseGuard", "preserveUsableOldResultsOnRecoverableError"],
          "properties": {
            "suggestionStaleResponseGuard": { "const": true },
            "resultStaleResponseGuard": { "const": true },
            "preserveUsableOldResultsOnRecoverableError": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "required": ["quickFilter", "advancedSurface", "feedback"],
      "properties": {
        "quickFilter": {
          "type": "object",
          "required": ["semanticRole", "peerViewNavigation", "recommendedVisibleCount", "activeCueNonColorOnly"],
          "properties": {
            "semanticRole": { "const": "collection-condition" },
            "peerViewNavigation": { "const": false },
            "recommendedVisibleCount": {
              "type": "array",
              "items": { "type": "integer" },
              "uniqueItems": true
            },
            "activeCueNonColorOnly": { "const": true }
          },
          "additionalProperties": false
        },
        "advancedSurface": {
          "type": "object",
          "required": ["defaultPresentation", "complexPresentation", "applyIsCommitBoundary", "dismissCommits", "resetClearsQuery"],
          "properties": {
            "defaultPresentation": { "const": "bottom-sheet" },
            "complexPresentation": { "const": "full-screen-or-full-height" },
            "applyIsCommitBoundary": { "const": true },
            "dismissCommits": { "const": false },
            "resetClearsQuery": { "const": false }
          },
          "additionalProperties": false
        },
        "feedback": {
          "type": "object",
          "required": ["resultCountAccessible", "zeroResultRecoveryRequired", "disabledApplyOnlyNoChangeSignal"],
          "properties": {
            "resultCountAccessible": { "const": true },
            "zeroResultRecoveryRequired": { "const": true },
            "disabledApplyOnlyNoChangeSignal": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "restoration": {
      "type": "object",
      "required": ["detailReturn", "fields", "invalidatedWhen"],
      "properties": {
        "detailReturn": { "const": "restore-active-collection-task" },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["committedQuery", "committedFilters", "sort", "loadedData", "scrollPosition"]
          }
        },
        "invalidatedWhen": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["collection-identity-changed", "product-explicit-refresh", "restoration-expired"] }
        }
      },
      "additionalProperties": false
    },
    "platformMappings": {
      "type": "object",
      "required": ["ios", "android", "wechat-mini-program"],
      "properties": {
        "ios": { "type": "object" },
        "android": { "type": "object" },
        "wechat-mini-program": { "type": "object" }
      },
      "additionalProperties": false
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "scenario", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scenario": { "type": "object" },
          "expected": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
