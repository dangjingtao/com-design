{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://com-design.local/schemas/composite-contract-v1.schema.json",
  "title": "Com Design Core Composite Component Contract",
  "type": "object",
  "required": ["schemaVersion", "scope", "status", "composites"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "company-mobile-core" },
    "status": { "type": "string" },
    "principle": { "type": "string" },
    "composites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "cn", "intent", "components", "anatomy", "rules", "avoid"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "cn": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "components": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "anatomy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "variants": { "type": "array", "items": { "type": "string" } },
          "rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "avoid": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "relatedPatterns": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
