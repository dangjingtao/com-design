{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://com-design.local/schemas/state-feedback-v2.schema.json",
  "title": "Com Design State Feedback Semantics V2",
  "type": "object",
  "required": ["$schema","schemaVersion","id","$metadata","scope","references","selection","emptyState","resultState","alertFamily","blockingState","transientFeedback","fieldValidationBoundary","examples"],
  "properties": {
    "$schema": {"type":"string","minLength":1},
    "schemaVersion": {"const":2},
    "id": {"const":"com-design:state-feedback:v2"},
    "$metadata": {
      "type":"object",
      "required":["name","owner","status","canonical"],
      "properties":{
        "name":{"type":"string","minLength":1},
        "owner":{"const":"T023"},
        "status":{"type":"string","minLength":1},
        "canonical":{"const":true}
      },
      "additionalProperties":false
    },
    "scope":{
      "type":"object",
      "required":["addsCoreComponent","addsCorePattern","coreComponentAdded"],
      "properties":{
        "addsCoreComponent":{"const":true},
        "addsCorePattern":{"const":false},
        "coreComponentAdded":{"const":"result-state"}
      },
      "additionalProperties":false
    },
    "references":{
      "type":"object",
      "required":["components","pattern"],
      "properties":{
        "components":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "pattern":{"const":"statusComposition"}
      },
      "additionalProperties":false
    },
    "selection":{
      "type":"object",
      "required":["absence","taskOutcome","localPersistent","pagePersistent","transientAcknowledgement","transientActionable","fieldError","externalBlock"],
      "properties":{
        "absence":{"const":"empty-state"},
        "taskOutcome":{"const":"result-state"},
        "localPersistent":{"const":"alert:inline"},
        "pagePersistent":{"const":"alert:banner"},
        "transientAcknowledgement":{"const":"toast"},
        "transientActionable":{"const":"snackbar"},
        "fieldError":{"const":"field-validation"},
        "externalBlock":{"const":"blocking-state"}
      },
      "additionalProperties":false
    },
    "emptyState":{
      "type":"object",
      "required":["allowedVariants","genericRecoverableErrorAllowed","semanticColorDefault"],
      "properties":{
        "allowedVariants":{"type":"array","uniqueItems":true,"items":{"enum":["first-use","no-data","no-results"]}},
        "genericRecoverableErrorAllowed":{"const":false},
        "semanticColorDefault":{"const":false}
      },
      "additionalProperties":false
    },
    "resultState":{
      "type":"object",
      "required":["tones","maxPrimaryActions","fieldErrorsAllowed","pendingMustExplainExitOrReturn"],
      "properties":{
        "tones":{"type":"array","uniqueItems":true,"items":{"enum":["success","error","warning","info","pending"]}},
        "maxPrimaryActions":{"const":1},
        "fieldErrorsAllowed":{"const":false},
        "pendingMustExplainExitOrReturn":{"const":true}
      },
      "additionalProperties":false
    },
    "alertFamily":{
      "type":"object",
      "required":["toneOrthogonalToPresentation","inline","banner"],
      "properties":{
        "toneOrthogonalToPresentation":{"const":true},
        "inline":{
          "type":"object",
          "required":["scope","placement","geometry","dismissDefault"],
          "properties":{
            "scope":{"const":"local-context"},
            "placement":{"const":"normal-content-flow"},
            "geometry":{"const":"contained-local-surface"},
            "dismissDefault":{"const":"non-dismissible"}
          },
          "additionalProperties":false
        },
        "banner":{
          "type":"object",
          "required":["scope","placement","geometry","dismissRequiresSafeIgnore","stacking"],
          "properties":{
            "scope":{"const":"page-or-region"},
            "placement":{"const":"structural-notification-slot"},
            "geometry":{"const":"flatter-edge-or-inset-aware"},
            "dismissRequiresSafeIgnore":{"const":true},
            "stacking":{"const":"prioritize-merge-or-queue"}
          },
          "additionalProperties":false
        }
      },
      "additionalProperties":false
    },
    "blockingState":{
      "type":"object",
      "required":["promotedToCorePattern","causes","requiredContent","nextActions"],
      "properties":{
        "promotedToCorePattern":{"const":false},
        "causes":{"type":"array","uniqueItems":true,"items":{"enum":["system-block","offline","permission-denied","unavailable","maintenance","not-found"]}},
        "requiredContent":{"type":"array","uniqueItems":true,"items":{"enum":["cause","scope","next-action"]}},
        "nextActions":{"type":"object"}
      },
      "additionalProperties":false
    },
    "transientFeedback":{
      "type":"object",
      "required":["toast","snackbar","criticalFailureToastOnlyAllowed"],
      "properties":{
        "toast":{"const":"short-non-durable-acknowledgement"},
        "snackbar":{"const":"short-feedback-with-at-most-one-action"},
        "criticalFailureToastOnlyAllowed":{"const":false}
      },
      "additionalProperties":false
    },
    "fieldValidationBoundary":{
      "type":"object",
      "required":["owner","globalFeedbackMayReplaceFieldError"],
      "properties":{
        "owner":{"const":"field-or-form-validation"},
        "globalFeedbackMayReplaceFieldError":{"const":false}
      },
      "additionalProperties":false
    },
    "examples":{"type":"array","minItems":8,"items":{"type":"object"}}
  },
  "additionalProperties":false
}
