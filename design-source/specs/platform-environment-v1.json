{
  "$metadata": {
    "name": "Com Design Platform Environment Contract",
    "version": 1,
    "status": "v2-first-stage",
    "owner": "T010",
    "snapshotSchema": "../schemas/platform-environment-v1.schema.json",
    "platformModel": "./platform-model-v2.json"
  },
  "purpose": "Expose runtime geometry, host/system chrome and interaction/accessibility capabilities to Platform Adapters without forking or mutating Core semantics.",
  "principles": {
    "runtimeFactsNotPlatformAssumptions": true,
    "platformDoesNotInferCapabilities": true,
    "systemAndHostChromeAreNotCore": true,
    "componentsDoNotProbeHostChromeDirectly": true,
    "adapterConsumesEnvironment": true
  },
  "ownership": {
    "environment": "platform-adapter",
    "coreSemantics": "com-design-core",
    "systemChrome": "system",
    "hostChrome": "host",
    "productBusinessLogic": "product"
  },
  "invariants": {
    "coreSemanticsMutable": false,
    "actionHierarchyMutable": false,
    "taskResultMutable": false,
    "authoritativeStateMutable": false,
    "platformPresentationSelectionAllowed": true
  },
  "presentationPolicy": {
    "consumers": ["navigation", "overlay", "select", "dialog", "sheet", "menu", "picker"],
    "selectionInputs": ["safe-area", "reserved-region", "system-host-chrome", "back", "focus", "keyboard-ime", "pointer", "gesture", "overlay-dismissal", "accessibility"],
    "allowedToVary": ["placement", "transition", "system-gesture", "detent", "positioning", "focus-behavior", "keyboard-behavior", "limited-anatomy"],
    "mustRemainEquivalent": ["task-result", "authoritative-state", "state-semantics", "action-hierarchy", "submit-cancel-back-failure-retry-semantics"],
    "rule": "A Platform Adapter may choose a native or host-appropriate presentation from environment facts, but the chosen presentation must preserve Core task and state semantics."
  },
  "responsibilityBoundary": {
    "T010": ["safe-area", "reserved-region", "system-host-chrome", "back-capability", "focus-capability", "keyboard-ime-capability", "pointer-capability", "gesture-capability", "overlay-dismissal-capability", "system-owned-ui-capability", "accessibility-hooks"],
    "T011": ["motion semantics", "standard-reduced motion mapping"],
    "T012": ["responsive layout behavior", "input-modality interaction-state behavior", "content-scale reflow"],
    "T020": ["top app bar", "side navigation", "navigation component presentation"],
    "note": "T010 exposes environment facts/capabilities only. It does not define motion choreography, responsive breakpoints, component interaction-state vocabulary, or concrete navigation components."
  },
  "measurementPolicy": {
    "geometryUnit": "px",
    "runtimeProvided": true,
    "exampleMeasurementsNormative": false,
    "rule": "Insets and rectangles are runtime observations in the current app coordinate space. Example numbers demonstrate shape only and must never be copied as device constants."
  },
  "examples": [
    {
      "name": "ios-compact-runtime",
      "platform": "ios",
      "snapshot": {
        "schemaVersion": 1,
        "platform": "ios",
        "geometry": {
          "unit": "px",
          "safeAreaInsets": {"top": 59, "right": 0, "bottom": 34, "left": 0},
          "reservedRegions": [
            {"id": "ios-status-area", "owner": "system", "kind": "status-bar", "edge": "top", "rect": {"x": 0, "y": 0, "width": 393, "height": 59}, "affectsLayout": true, "comDesignOwned": false},
            {"id": "ios-home-indicator", "owner": "system", "kind": "home-indicator", "edge": "bottom", "rect": {"x": 0, "y": 818, "width": 393, "height": 34}, "affectsLayout": true, "comDesignOwned": false}
          ]
        },
        "chrome": [
          {"id": "ios-status-bar", "owner": "system", "kind": "status-bar", "comDesignOwned": false, "reservedRegionIds": ["ios-status-area"]},
          {"id": "ios-home-indicator-chrome", "owner": "system", "kind": "home-indicator", "comDesignOwned": false, "reservedRegionIds": ["ios-home-indicator"]}
        ],
        "back": {"available": true, "mechanisms": ["system-gesture", "app-action"], "predictive": false},
        "focus": {"supported": true, "focusVisible": "platform-managed", "programmatic": true},
        "keyboardIme": {"supported": true, "composition": true, "viewportBehavior": "resize-or-overlay", "dismissal": ["system", "explicit"]},
        "pointer": {"supported": false, "hover": false, "precision": "none"},
        "gesture": {"supported": true, "backGesture": "edge-swipe", "systemReservedEdges": ["top", "bottom", "left"]},
        "overlay": {"dismissalMechanisms": ["explicit", "tap-outside", "swipe", "system"], "systemOwnedUi": [{"kind": "picker", "owner": "system"}, {"kind": "share-sheet", "owner": "system"}]},
        "accessibility": {"contentScale": "platform-driven", "contentScaleHook": "system", "screenReaderHook": true}
      }
    },
    {
      "name": "android-compact-runtime",
      "platform": "android",
      "snapshot": {
        "schemaVersion": 1,
        "platform": "android",
        "geometry": {
          "unit": "px",
          "safeAreaInsets": {"top": 24, "right": 0, "bottom": 24, "left": 0},
          "reservedRegions": [
            {"id": "android-status-area", "owner": "system", "kind": "status-bar", "edge": "top", "rect": {"x": 0, "y": 0, "width": 412, "height": 24}, "affectsLayout": true, "comDesignOwned": false},
            {"id": "android-gesture-inset", "owner": "system", "kind": "gesture-inset", "edge": "bottom", "rect": {"x": 0, "y": 891, "width": 412, "height": 24}, "affectsLayout": true, "comDesignOwned": false}
          ]
        },
        "chrome": [
          {"id": "android-status-bar", "owner": "system", "kind": "status-bar", "comDesignOwned": false, "reservedRegionIds": ["android-status-area"]},
          {"id": "android-system-navigation", "owner": "system", "kind": "system-navigation", "comDesignOwned": false, "reservedRegionIds": ["android-gesture-inset"]}
        ],
        "back": {"available": true, "mechanisms": ["system-button", "system-gesture", "app-action"], "predictive": true},
        "focus": {"supported": true, "focusVisible": "platform-managed", "programmatic": true},
        "keyboardIme": {"supported": true, "composition": true, "viewportBehavior": "resize-or-overlay", "dismissal": ["system", "back", "explicit"]},
        "pointer": {"supported": false, "hover": false, "precision": "none"},
        "gesture": {"supported": true, "backGesture": "system-predictive", "systemReservedEdges": ["top", "bottom", "left", "right"]},
        "overlay": {"dismissalMechanisms": ["explicit", "tap-outside", "back", "swipe", "system"], "systemOwnedUi": [{"kind": "picker", "owner": "system"}, {"kind": "permission-prompt", "owner": "system"}]},
        "accessibility": {"contentScale": "platform-driven", "contentScaleHook": "system", "screenReaderHook": true}
      }
    },
    {
      "name": "web-wide-keyboard-pointer-runtime",
      "platform": "web",
      "snapshot": {
        "schemaVersion": 1,
        "platform": "web",
        "geometry": {"unit": "px", "safeAreaInsets": {"top": 0, "right": 0, "bottom": 0, "left": 0}, "reservedRegions": []},
        "chrome": [],
        "back": {"available": true, "mechanisms": ["history", "app-action"], "predictive": false},
        "focus": {"supported": true, "focusVisible": "required", "programmatic": true},
        "keyboardIme": {"supported": true, "composition": true, "viewportBehavior": "resize-or-overlay", "dismissal": ["explicit", "tap-outside"]},
        "pointer": {"supported": true, "hover": true, "precision": "fine"},
        "gesture": {"supported": true, "backGesture": "none", "systemReservedEdges": []},
        "overlay": {"dismissalMechanisms": ["explicit", "tap-outside", "escape"], "systemOwnedUi": [{"kind": "file-picker", "owner": "system"}]},
        "accessibility": {"contentScale": "standard", "contentScaleHook": "css-user-agent", "screenReaderHook": true}
      }
    },
    {
      "name": "wechat-mini-program-runtime",
      "platform": "wechat-mini-program",
      "snapshot": {
        "schemaVersion": 1,
        "platform": "wechat-mini-program",
        "geometry": {
          "unit": "px",
          "safeAreaInsets": {"top": 47, "right": 0, "bottom": 0, "left": 0},
          "reservedRegions": [
            {"id": "wechat-capsule-region", "owner": "host", "kind": "host-capsule", "edge": "top-right", "rect": {"x": 286, "y": 7, "width": 87, "height": 32}, "affectsLayout": true, "comDesignOwned": false}
          ]
        },
        "chrome": [
          {"id": "wechat-capsule", "owner": "host", "kind": "host-capsule", "comDesignOwned": false, "reservedRegionIds": ["wechat-capsule-region"]}
        ],
        "back": {"available": true, "mechanisms": ["host-action", "app-action"], "predictive": false},
        "focus": {"supported": true, "focusVisible": "platform-managed", "programmatic": true},
        "keyboardIme": {"supported": true, "composition": true, "viewportBehavior": "resize-or-overlay", "dismissal": ["system", "explicit", "back"]},
        "pointer": {"supported": false, "hover": false, "precision": "none"},
        "gesture": {"supported": true, "backGesture": "host-managed", "systemReservedEdges": ["top"]},
        "overlay": {"dismissalMechanisms": ["explicit", "tap-outside", "back", "system"], "systemOwnedUi": [{"kind": "picker", "owner": "host"}, {"kind": "share-sheet", "owner": "host"}]},
        "accessibility": {"contentScale": "platform-driven", "contentScaleHook": "host", "screenReaderHook": true}
      }
    }
  ]
}
