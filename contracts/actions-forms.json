{
  "$metadata": {
    "name": "Com Design Mobile — Actions & Forms",
    "version": "0.2.2",
    "phase": 2,
    "status": "candidate",
    "foundation": "../tokens/tokens.json",
    "contractSchema": "../schemas/component-contract-v1.schema.json",
    "tokenNamespace": "semantic.light",
    "modeNamespace": "modes",
    "refRules": {
      "tokenRef": "Resolve relative to semantic.light unless the ref starts with primitive., semantic., or modes.; shared non-theme semantics use absolute semantic.shared.* refs",
      "modeRef": "Resolve against the active mode on the named axis; for example density.controlHeight => modes.density.<active>.controlHeight",
      "fixedValue": "Allowed only for component-local geometry that has no stable cross-component semantic role"
    },
    "principles": ["mobile-first", "compact-first", "flat-first", "semantic-color-only", "lazy-component-tokens"]
  },
  "shared": {
    "density": {
      "default": "compact",
      "controlHeight": {"modeRef": "density.controlHeight"},
      "controlHeightLarge": {"modeRef": "density.controlHeightLarge"},
      "paddingHorizontal": {"modeRef": "density.paddingHorizontal"},
      "paddingVertical": {"modeRef": "density.paddingVertical"},
      "internalGap": {"modeRef": "density.internalGap"},
      "fieldLabelGap": {"modeRef": "density.fieldLabelGap"},
      "fieldHelperGap": {"modeRef": "density.fieldHelperGap"},
      "fieldGap": {"modeRef": "density.fieldGap"}
    },
    "touchTarget": {
      "ios": {"modeRef": "platform.ios.touchTargetMin"},
      "android": {"modeRef": "platform.android.touchTargetMin"},
      "rule": "visual size and interactive hit area are independent"
    },
    "focus": {
      "color": {"tokenRef": "color.border.focused"},
      "width": {"tokenRef": "border.focus"},
      "shadow": false,
      "errorPrecedence": true
    },
    "fieldFamily": {
      "radius": {"tokenRef": "radius.control"},
      "borderWidth": {"tokenRef": "border.control"},
      "borderDefault": {"tokenRef": "color.border.default"},
      "borderError": {"tokenRef": "color.border.error"},
      "surface": {"tokenRef": "color.surface.default"},
      "surfaceDisabled": {"tokenRef": "color.surface.subtle"},
      "valueText": {"tokenRef": "color.text.primary"},
      "placeholderText": {"tokenRef": "color.text.placeholder"},
      "disabledText": {"tokenRef": "color.text.disabled"},
      "labelTypography": {"tokenRef": "typography.labelSmall"},
      "valueTypography": {"tokenRef": "typography.body"},
      "helperTypography": {"tokenRef": "typography.caption"},
      "labelGap": {"modeRef": "density.fieldLabelGap"},
      "helperGap": {"modeRef": "density.fieldHelperGap"},
      "fieldGap": {"modeRef": "density.fieldGap"}
    }
  },
  "components": {
    "button": {
      "role": "action",
      "anatomy": ["container", "leadingIcon?", "label", "trailingIcon?", "spinner?"],
      "sizes": {
        "regular": {"height": {"modeRef": "density.controlHeight"}},
        "large": {"height": {"modeRef": "density.controlHeightLarge"}}
      },
      "geometry": {
        "radius": {"tokenRef": "radius.control"},
        "paddingHorizontal": {"modeRef": "density.paddingHorizontal"},
        "gap": {"modeRef": "density.internalGap"},
        "iconSize": {"tokenRef": "semantic.shared.icon.size.medium"},
        "spinnerSize": {"tokenRef": "semantic.shared.indicator.size.inline"}
      },
      "typography": {"label": {"tokenRef": "typography.label"}},
      "variants": {
        "primary": {
          "default": {"background": "color.action.primary", "label": "color.text.inverse"},
          "pressed": {"background": "color.action.primaryPressed", "label": "color.text.inverse"},
          "disabled": {"background": "color.action.disabled", "label": "color.text.disabled"}
        },
        "secondary": {
          "default": {"background": "color.action.secondary", "label": "color.text.brand"},
          "pressed": {"background": "color.action.secondaryPressed", "label": "color.text.brand"},
          "disabled": {"background": "color.action.disabled", "label": "color.text.disabled"}
        },
        "outline": {
          "default": {"background": "color.surface.default", "border": "color.border.default", "label": "color.text.brand"},
          "pressed": {"background": "color.surface.selected", "border": "color.border.default", "label": "color.text.brand"},
          "disabled": {"background": "color.surface.default", "border": "color.border.subtle", "label": "color.text.disabled"}
        },
        "ghost": {
          "default": {"background": "transparent", "label": "color.text.brand"},
          "pressed": {"background": "color.surface.selected", "label": "color.text.brand"},
          "disabled": {"background": "transparent", "label": "color.text.disabled"}
        },
        "destructive": {
          "default": {"background": "color.action.destructive", "label": "color.text.inverse"},
          "pressed": {"background": "color.action.destructivePressed", "label": "color.text.inverse"},
          "disabled": {"background": "color.action.disabled", "label": "color.text.disabled"}
        }
      },
      "states": ["default", "pressed", "disabled", "loading", "focused?"],
      "loading": {"locksWidth": true, "repeatAction": false, "announcesBusyState": true},
      "accessibility": {"role": "button", "requiresAccessibleName": true},
      "constraints": ["do not create a 32px interactive button size", "avoid competing adjacent primary actions", "no default elevation or shadow"]
    },
    "iconButton": {
      "role": "icon-action",
      "anatomy": ["container", "icon"],
      "sizes": {
        "regular": {"container": {"modeRef": "density.controlHeight"}, "icon": {"tokenRef": "semantic.shared.icon.size.medium"}},
        "large": {"container": {"modeRef": "density.controlHeightLarge"}, "icon": {"tokenRef": "semantic.shared.icon.size.large"}}
      },
      "geometry": {"radius": {"tokenRef": "radius.control"}},
      "variants": {
        "ghost": {
          "default": {"background": "transparent", "icon": "color.text.primary"},
          "pressed": {"background": "color.surface.pressed", "icon": "color.text.primary"},
          "selected": {"background": "color.surface.selected", "icon": "color.text.brand"},
          "disabled": {"background": "transparent", "icon": "color.text.disabled"}
        },
        "subtle": {
          "default": {"background": "color.surface.subtle", "icon": "color.text.primary"},
          "pressed": {"background": "color.surface.pressed", "icon": "color.text.primary"},
          "selected": {"background": "color.surface.selected", "icon": "color.text.brand"},
          "disabled": {"background": "color.surface.subtle", "icon": "color.text.disabled"}
        },
        "destructive": {
          "default": {"background": "transparent", "icon": "color.status.dangerText"},
          "pressed": {"background": "color.status.dangerBg", "icon": "color.status.dangerText"},
          "disabled": {"background": "transparent", "icon": "color.text.disabled"}
        }
      },
      "states": ["default", "pressed", "selected?", "disabled", "focused?"],
      "accessibility": {"role": "button", "requiresAccessibleName": true},
      "constraints": ["use text button when icon meaning is ambiguous", "visual container may be smaller than platform hit area only when the hit target is expanded externally"]
    },
    "input": {
      "role": "text-input",
      "family": "fieldFamily",
      "appearance": ["outlined"],
      "anatomy": ["label?", "container", "leading?", "valueOrPlaceholder", "trailingAction?", "helper?"],
      "geometry": {"systemIconAdornmentSize": {"tokenRef": "semantic.shared.icon.size.medium"}},
      "height": {"modeRef": "density.controlHeight"},
      "states": {
        "empty": {"border": "color.border.default", "background": "color.surface.default", "text": "color.text.placeholder"},
        "value": {"border": "color.border.default", "background": "color.surface.default", "text": "color.text.primary"},
        "focused": {"border": "color.border.focused", "borderWidth": {"tokenRef": "border.focus"}, "text": "color.text.primary"},
        "error": {"border": "color.border.error", "helper": "color.status.dangerText"},
        "disabled": {"background": "color.surface.subtle", "text": "color.text.disabled", "border": "color.border.subtle"},
        "readOnly": {"background": "color.surface.default", "text": "color.text.primary", "border": "color.border.subtle", "editable": false, "copyable": true}
      },
      "accessibility": {"requiresProgrammaticLabel": true, "helperAndErrorCanBeDescribedBy": true},
      "constraints": ["placeholder is not disabled", "one trailing high-frequency action maximum", "error+focus keeps danger semantics", "readOnly must remain visually distinct from disabled", "system icon adornments use the shared medium icon size; non-icon slots keep their own component semantics"]
    },
    "textarea": {
      "role": "multiline-text-input",
      "family": "fieldFamily",
      "appearance": ["outlined"],
      "minHeight": {
        "compact": {"value": 88, "unit": "px"},
        "comfortable": {"value": 96, "unit": "px"}
      },
      "recommendedMaxVisibleHeight": {
        "compact": {"value": 160, "unit": "px"},
        "comfortable": {"value": 176, "unit": "px"}
      },
      "statesFrom": "input",
      "counter": {"optional": true, "typography": "typography.caption", "color": "color.text.tertiary"},
      "accessibility": {"requiresProgrammaticLabel": true, "counterMustNotBeOnlyErrorSignal": true}
    },
    "select": {
      "role": "picker-trigger",
      "family": "fieldFamily",
      "height": {"modeRef": "density.controlHeight"},
      "anatomy": ["label?", "trigger", "valueOrPlaceholder", "disclosure", "helper?"],
      "disclosureSize": {"tokenRef": "semantic.shared.icon.size.medium"},
      "states": {
        "empty": {"background": "color.surface.default", "border": "color.border.default", "text": "color.text.placeholder", "disclosure": "color.text.tertiary"},
        "value": {"background": "color.surface.default", "border": "color.border.default", "text": "color.text.primary", "disclosure": "color.text.tertiary"},
        "pressed": {"background": "color.surface.pressed", "border": "color.border.default", "text": "color.text.primary"},
        "open": {"background": "color.surface.default", "border": "color.border.focused", "borderWidth": {"tokenRef": "border.focus"}, "text": "color.text.primary"},
        "error": {"background": "color.surface.default", "border": "color.border.error", "helper": "color.status.dangerText"},
        "disabled": {"background": "color.surface.subtle", "border": "color.border.subtle", "text": "color.text.disabled", "disclosure": "color.text.disabled"}
      },
      "accessibility": {"role": "button-or-platform-picker-trigger", "requiresAccessibleName": true, "mustExposeExpandedStateWhenOpen": true},
      "constraints": ["must not show a text cursor", "picker presentation is platform/overlay policy, not trigger appearance"]
    },
    "checkbox": {
      "role": "checkbox",
      "anatomy": ["indicator", "label?", "helper?"],
      "indicator": {"width": 20, "height": 20, "radius": 4, "unit": "px"},
      "states": {
        "unchecked": {"background": "color.surface.default", "border": "color.border.default", "label": "color.text.primary"},
        "checked": {"background": "color.action.primary", "mark": "color.text.inverse", "label": "color.text.primary"},
        "indeterminate": {"background": "color.action.primary", "mark": "color.text.inverse", "label": "color.text.primary"},
        "pressed": {"feedback": "color.surface.pressed"},
        "disabledUnchecked": {"background": "color.surface.subtle", "border": "color.border.subtle", "label": "color.text.disabled"},
        "disabledChecked": {"background": "color.action.disabled", "mark": "color.text.disabled", "label": "color.text.disabled"}
      },
      "accessibility": {"role": "checkbox", "exposesCheckedAndMixedState": true, "labelSharesHitTarget": true},
      "constraints": ["indicator and label share hit area", "validation error belongs to group/helper by default"]
    },
    "radio": {
      "role": "radio",
      "anatomy": ["outer", "innerDot?", "label?", "helper?"],
      "outer": {"width": 20, "height": 20, "unit": "px"},
      "innerDot": {"width": 8, "height": 8, "unit": "px"},
      "states": {
        "unselected": {"background": "color.surface.default", "border": "color.border.default", "label": "color.text.primary"},
        "selected": {"border": "color.action.primary", "dot": "color.action.primary", "label": "color.text.primary"},
        "pressed": {"feedback": "color.surface.pressed"},
        "disabledUnselected": {"border": "color.border.subtle", "label": "color.text.disabled"},
        "disabledSelected": {"border": "color.text.disabled", "dot": "color.text.disabled", "label": "color.text.disabled"}
      },
      "accessibility": {"role": "radio", "groupMustExposeSingleSelection": true, "labelSharesHitTarget": true},
      "constraints": ["use only for mutually exclusive groups", "tapping selected radio normally does not clear selection"]
    },
    "switch": {
      "role": "switch",
      "anatomy": ["track", "thumb", "externalLabel?"],
      "geometry": {
        "compact": {"trackWidth": 44, "trackHeight": 24, "thumb": 20, "unit": "px"},
        "comfortable": {"trackWidth": 48, "trackHeight": 28, "thumb": 24, "unit": "px"}
      },
      "states": {
        "off": {"track": "color.surface.subtle", "trackBorder": "color.border.default", "thumb": "color.surface.default", "label": "color.text.primary"},
        "on": {"track": "color.action.primary", "thumb": "color.surface.default", "label": "color.text.primary"},
        "pressed": {"feedback": "subtle-position-or-surface"},
        "disabledOff": {"track": "color.surface.subtle", "trackBorder": "color.border.subtle", "thumb": "color.surface.default", "label": "color.text.disabled"},
        "disabledOn": {"track": "color.action.disabled", "thumb": "color.surface.default", "label": "color.text.disabled"}
      },
      "accessibility": {"role": "switch", "exposesOnOffState": true, "externalLabelSharesHitTargetWhenPossible": true},
      "constraints": ["use for immediately applied binary state", "do not place ON/OFF text inside track", "disabled styling must preserve on/off distinction"]
    }
  },
  "validation": {
    "fieldErrorPreferred": true,
    "toastForFieldError": false,
    "messagePattern": "what happened + how to fix",
    "requiredMarkerMustBeConsistent": true,
    "requiredMarkerDefault": "asterisk-with-programmatic-required-state"
  }
}
