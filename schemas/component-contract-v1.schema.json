{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://com-design.local/schemas/component-contract-v1.schema.json",
  "title": "Com Design Component Contract V1",
  "type": "object",
  "required": ["$metadata", "shared", "components"],
  "properties": {
    "$metadata": {
      "type": "object",
      "required": ["name", "version", "phase", "foundation", "tokenNamespace", "modeNamespace"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "phase": {"type": "integer", "minimum": 1},
        "status": {"type": "string"},
        "foundation": {"type": "string"},
        "contractSchema": {"type": "string"},
        "tokenNamespace": {"type": "string"},
        "modeNamespace": {"type": "string"},
        "refRules": {"type": "object"},
        "principles": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "shared": {"type": "object"},
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/component"}
    },
    "validation": {"type": "object"}
  },
  "$defs": {
    "tokenRef": {
      "type": "object",
      "required": ["tokenRef"],
      "properties": {"tokenRef": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "modeRef": {
      "type": "object",
      "required": ["modeRef"],
      "properties": {"modeRef": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "fixedValue": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {},
        "unit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["anatomy"],
      "properties": {
        "role": {"type": "string"},
        "family": {"type": "string"},
        "appearance": {"type": "array", "items": {"type": "string"}},
        "anatomy": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "sizes": {"type": "object"},
        "geometry": {"type": "object"},
        "typography": {"type": "object"},
        "variants": {},
        "states": {},
        "loading": {"type": "object"},
        "counter": {"type": "object"},
        "height": {},
        "minHeight": {"type": "object"},
        "recommendedMaxVisibleHeight": {"type": "object"},
        "statesFrom": {"type": "string"},
        "disclosureSize": {},
        "indicator": {"type": "object"},
        "outer": {"type": "object"},
        "innerDot": {"type": "object"},
        "radius": {},
        "accessibility": {"type": "object"},
        "constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
